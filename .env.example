# Meshy API key (Settings > API in the Meshy dashboard)
MESHY_API_KEY=msy_xxxxxxxxxxxxxxxxxxxx

# Cloudflare R2, same variable names as A-Stuff. Only needed with --upload.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=a-antique
# Public base URL of the custom domain connected to the bucket, not the r2.cloudflarestorage.com endpoint
R2_PUBLIC_BASE_URL=https://cdn.example.com
